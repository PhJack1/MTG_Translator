{
  "manifest_version": 3,
  "name": "MTG Cards Translator",
  "version": "1.0",
  "description": "Translates MTG card names on MTG websites",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "64": "icon64.png",
    "96": "icon96.png",
    "128": "icon128.png"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://api.scryfall.com/"
  ],
  "action": {
    "default_icon": {
      "16": "popup/icons/icon16.png",
      "48": "popup/icons/icon48.png"
    },
    "default_title": "MTG Cards Translator",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"]
    }
  ],

"web_accessible_resources": [
  {
    "resources": ["assets/selectors.json"],
    "matches": ["<all_urls>"]
  }
]

}
